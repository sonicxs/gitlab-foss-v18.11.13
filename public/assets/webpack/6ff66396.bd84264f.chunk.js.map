    doc.loc.source = {"body":"#import \"~/graphql_shared/fragments/page_info.fragment.graphql\"\n#import \"~/graphql_shared/fragments/ci_icon.fragment.graphql\"\n\nquery getMergeRequestPipelines(\n  $mergeRequestIid: String!\n  $fullPath: ID!\n  $first: Int\n  $last: Int\n  $after: String\n  $before: String\n) {\n  project(fullPath: $fullPath) {\n    id\n    fullPath\n    mergeRequest(iid: $mergeRequestIid) {\n      id\n      iid\n      title\n      webPath\n      sourceBranch\n      pipelines(first: $first, last: $last, after: $after, before: $before) {\n        count\n        nodes {\n          id\n          iid\n          detailedStatus {\n            ...CiIcon\n            name\n          }\n          name\n          ref\n          refText\n          commit {\n            id\n            shortId\n            title\n            webUrl\n            author {\n              id\n              avatarUrl\n              webPath\n              name\n            }\n          }\n          user {\n            id\n            name\n            webPath\n            avatarUrl\n          }\n          source\n          latest\n          yamlErrors\n          yamlErrorMessages\n          failureReason\n          configSource\n          stuck\n          type\n          path\n          retryable\n          cancelable\n          stages {\n            nodes {\n              id\n              name\n              detailedStatus {\n                ...CiIcon\n                name\n                tooltip\n              }\n            }\n          }\n          mergeRequestEventType\n          project {\n            id\n            fullPath\n          }\n          hasManualActions\n          hasScheduledActions\n          failedJobsCount\n        }\n        pageInfo {\n          ...PageInfo\n        }\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

