    doc.loc.source = {"body":"# @feature_category: navigation\nquery userProjects(\n  $limit: Int!\n  $includeFrecent: Boolean!\n  $includeStarred: Boolean!\n  $includePersonal: Boolean!\n  $includeCurrentUser: Boolean!\n) {\n  frecentProjects @include(if: $includeFrecent) {\n    id\n    name\n    namespace: nameWithNamespace\n    avatarUrl\n    webPath\n  }\n  currentUser @include(if: $includeCurrentUser) {\n    id\n    starredProjects(first: $limit) @include(if: $includeStarred) {\n      nodes {\n        id\n        name\n        namespace: nameWithNamespace\n        avatarUrl\n        webPath\n      }\n    }\n    namespace @include(if: $includePersonal) {\n      id\n      projects(first: $limit) {\n        nodes {\n          id\n          name\n          namespace: nameWithNamespace\n          avatarUrl\n          webPath\n        }\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

    var names = {};
