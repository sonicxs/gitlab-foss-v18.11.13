    doc.loc.source = {"body":"# @feature_category: portfolio_management\nquery parentWorkItems(\n  $search: String\n  $fullPath: ID!\n  $groupPath: ID!\n  $types: [IssueType!]\n  $workItemTypeIds: [WorkItemsTypeID!]\n  $in: [IssuableSearchableField!]\n  $ids: [WorkItemID!]\n  $includeAncestors: Boolean = false\n  $includeDescendants: Boolean = false\n  $isProject: Boolean!\n) {\n  group(fullPath: $groupPath) {\n    id\n    workItems(\n      search: $search\n      types: $types\n      workItemTypeIds: $workItemTypeIds\n      in: $in\n      includeAncestors: $includeAncestors\n      includeDescendants: $includeDescendants\n    ) {\n      nodes {\n        id\n        iid\n        title\n      }\n    }\n  }\n  project(fullPath: $fullPath) @include(if: $isProject) {\n    id\n    workItems(\n      search: $search\n      types: $types\n      workItemTypeIds: $workItemTypeIds\n      in: $in\n      ids: $ids\n    ) {\n      nodes {\n        id\n        iid\n        title\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

    var names = {};
    function unique(defs) {
      return defs.filter(
        function(def) {
          if (def.kind !== 'FragmentDefinition') return true;
          var name = def.name.value
          if (names[name]) {
